{
  "_comment": [
    "FW-126.4 TRGO parity A/B probe - the 0x602E payload layout, defined ONCE.",
    "",
    "WHY THIS FILE EXISTS. FW-126.3 had the layout written out twice, in the JS decoder and in",
    "the PowerShell one. They drifted: the JS side was moved to schema 2 and the PowerShell side",
    "was not, so it read a schema 2 payload with schema 1 offsets, printed BAD MAGIC, and then",
    "printed a verdict anyway - the exact opposite of the truth. Both decoders now read their",
    "offsets from this file, and a golden-payload test runs both and compares them field by field.",
    "",
    "Types: u8, u16, i16, u32 - all little-endian, matching src/CAN_Display.c put_u16_le().",
    "Producer: src/CAN_Display.c fw1264_serialize_probe(). Keep them in step; the golden test",
    "in the Canable repo fails loudly if they part company."
  ],
  "magic": [67, 80],
  "magic_text": "CP",
  "schema": 3,
  "length": 55,
  "crc": { "offset": 53, "over": 53, "algorithm": "crc16-ccitt-false" },
  "verdict_thresholds": {
    "near_zero_abs_max": 300,
    "high_abs_min": 1000
  },
  "phases": ["A", "B", "C"],
  "phase_adc": { "A": 2, "B": 1, "C": 0 },
  "trigger_source_names": {
    "0": "T0_TRGO", "1": "T0_CH3", "2": "T1_TRGO/T3_CH2", "3": "T1_CH0/T7_CH1",
    "4": "T2_CH3/T7_CH3", "5": "T3_TRGO/T4_TRGO", "6": "EXTI15/T4_CH3", "7": "SOFTWARE"
  },
  "trgo_mode_names": {
    "0": "RESET(UPG)", "1": "ENABLE", "2": "UPDATE", "3": "CH0",
    "4": "O0CPRE", "5": "O1CPRE", "6": "O2CPRE", "7": "O3CPRE"
  },
  "fields": [
    { "name": "magic0",            "offset": 0,  "type": "u8" },
    { "name": "magic1",            "offset": 1,  "type": "u8" },
    { "name": "schema",            "offset": 2,  "type": "u8" },

    { "name": "flags",             "offset": 3,  "type": "u8",
      "bits": { "moe_off": 0, "poen_off": 1, "timer_running": 2, "restore_ok": 3, "done": 4 } },

    { "name": "ch3",               "offset": 4,  "type": "u16" },
    { "name": "adc0_src_before",   "offset": 6,  "type": "u8" },
    { "name": "adc2_src_before",   "offset": 7,  "type": "u8" },
    { "name": "adc0_src_restored", "offset": 8,  "type": "u8" },
    { "name": "adc2_src_restored", "offset": 9,  "type": "u8" },
    { "name": "trgo_before",       "offset": 10, "type": "u8" },
    { "name": "trgo_during",       "offset": 11, "type": "u8" },
    { "name": "trgo_restored",     "offset": 12, "type": "u8" },

    { "name": "sw_n_A",       "offset": 13, "type": "u8" },
    { "name": "sw_n_B",       "offset": 14, "type": "u8" },
    { "name": "sw_n_C",       "offset": 15, "type": "u8" },
    { "name": "sw_med_A",     "offset": 16, "type": "i16" },
